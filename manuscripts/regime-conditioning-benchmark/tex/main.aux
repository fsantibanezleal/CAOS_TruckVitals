\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces The detector-free effect size. Median (p10--p90 over channels) fault signature per C-MAPSS subset, measured in pooled sigma (blue) and within-regime sigma (orange). Single-condition subsets (FD001, FD003) return a ratio of exactly $1.00$, the built-in negative control; six-condition subsets return $90.2$ and $62.3$.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:mechanism}{{1}{2}{The detector-free effect size. Median (p10--p90 over channels) fault signature per C-MAPSS subset, measured in pooled sigma (blue) and within-regime sigma (orange). Single-condition subsets (FD001, FD003) return a ratio of exactly $1.00$, the built-in negative control; six-condition subsets return $90.2$ and $62.3$}{figure.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces C-MAPSS detection at a matched false-alarm budget (CUSUM, one false alarm per $1000$ cycles). Arms conditioned on a regime are bold. Units: faulty units scored. Global-regr is a single global context regression without segmentation: it conditions on context but is not a regime model, so it is reported separately.}}{2}{table.1}\protected@file@percent }
\newlabel{tab:contrast}{{I}{2}{C-MAPSS detection at a matched false-alarm budget (CUSUM, one false alarm per $1000$ cycles). Arms conditioned on a regime are bold. Units: faulty units scored. Global-regr is a single global context regression without segmentation: it conditions on context but is not a regime model, so it is reported separately}{table.1}{}}
